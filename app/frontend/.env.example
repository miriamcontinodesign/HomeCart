# Copy to .env and fill in values. EXPO_PUBLIC_* values are baked into the
# web bundle at build time and visible to every visitor — never put secrets here.

# Backend URL (local dev or your Render service)
EXPO_PUBLIC_API_URL=http://localhost:8000

# Supabase (anon/publishable key only — never the service key)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps JavaScript API key for the in-browser map. Restrict it by HTTP referrer
# (localhost:8081 + your production domain) and to the Maps JavaScript API only.
EXPO_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Optional: Map ID from Cloud Console → Map Management (defaults to DEMO_MAP_ID)
EXPO_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Optional: hCaptcha site key (public). Required once CAPTCHA protection is switched on in
# Supabase → Authentication → Attack Protection (the secret key goes there, never here).
EXPO_PUBLIC_HCAPTCHA_SITE_KEY=
