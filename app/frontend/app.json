{
  "expo": {
    "name": "HomeCart",
    "slug": "homecart",
    "scheme": "homecart",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "HomeCart",
      "shortName": "HomeCart",
      "themeColor": "#F6ECDC",
      "backgroundColor": "#F6ECDC"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow HomeCart to use your location to find nearby stores."
        }
      ]
    ]
  }
}
